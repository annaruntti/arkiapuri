{
    "expo": {
        "name": "Arkiapuri",
        "slug": "arkiapuri",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./src/assets/images/arkiapuri-logo.png",
        "userInterfaceStyle": "light",
        "assetBundlePatterns": ["**/*"],
        "plugins": [
            [
                "expo-font",
                {
                    "fonts": ["./src/assets/fonts/FiraSans-Regular.ttf"]
                }
            ],
            "expo-web-browser",
            [
                "expo-camera",
                {
                    "cameraPermission": "Arkiapuri käyttää kameraa viivakoodien lukemiseen.",
                    "recordAudioAndroid": false
                }
            ],
            [
                "expo-splash-screen",
                {
                    "image": "./src/assets/images/arkiapuri-logo.png",
                    "resizeMode": "contain",
                    "backgroundColor": "#DCD4FC",
                    "imageWidth": 200
                }
            ]
        ],
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.arkiapuri.app",
            "infoPlist": {
                "NSCameraUsageDescription": "Arkiapuri käyttää kameraa viivakoodien lukemiseen."
            }
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./src/assets/images/arkiapuri-logo.png",
                "backgroundColor": "#DCD4FC"
            },
            "package": "com.arkiapuri.app"
        },
        "web": {
            "favicon": "./src/assets/images/arkiapuri-logo.png"
        },
        "extra": {
            "eas": {
                "projectId": "1bdb8dd2-eabf-4c1d-aa70-e6084a64f1ce"
            }
        }
    }
}
